{
  "name": "heal-stacked-pr-concurrency-cancels",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that reruns workflow runs cancelled by cancel-in-progress when stacked-PR tools deliver two webhooks per submit.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "all": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "keywords": ["github-actions", "ci", "workflow", "rerun", "graphite", "stacked-prs", "concurrency"],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.0"
  }
}
