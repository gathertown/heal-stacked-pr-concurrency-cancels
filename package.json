{
  "name": "heal-stacked-pr-concurrency-cancels",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that reruns workflow runs cancelled by cancel-in-progress when stacked-PR tools deliver two webhooks per submit.",
  "author": "Andrew Smith <andrew@gather.town>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gathertown/heal-stacked-pr-concurrency-cancels.git"
  },
  "bugs": {
    "url": "https://github.com/gathertown/heal-stacked-pr-concurrency-cancels/issues"
  },
  "homepage": "https://github.com/gathertown/heal-stacked-pr-concurrency-cancels#readme",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "lint": "prettier --check . && eslint src --ext .ts",
    "lint:fix": "prettier --write . && eslint src --ext .ts --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "all": "yarn lint && yarn typecheck && yarn test && yarn build",
    "dist:check": "yarn build && git diff --exit-code -- dist",
    "release:patch": "yarn version --new-version patch",
    "release:minor": "yarn version --new-version minor",
    "release:major": "yarn version --new-version major",
    "preversion": "yarn all && git diff --quiet HEAD",
    "version": "yarn build && git add dist",
    "postversion": "node scripts/postversion.js"
  },
  "keywords": [
    "github-actions",
    "ci",
    "workflow",
    "rerun",
    "graphite",
    "stacked-prs",
    "concurrency",
    "cancelled"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.0"
  }
}
